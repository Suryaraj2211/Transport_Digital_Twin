# Tell GitHub to ignore built assets and backend node scripts in repo language statistics
dist/** linguist-generated=true
dist/** linguist-vendored=true
dist/assets/* linguist-generated=true
api/*.js linguist-vendored=true
server.js linguist-vendored=true
local-server.js linguist-vendored=true
*.js linguist-detectable=false

# Mark TypeScript and TSX files
*.tsx linguist-language=TypeScript
*.ts linguist-language=TypeScript
