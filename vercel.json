{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin.css",
      "destination": "/admin/admin.css"
    },
    {
      "source": "/admin.js",
      "destination": "/admin/admin.js"
    },
    {
      "source": "/driver.css",
      "destination": "/driver/driver.css"
    },
    {
      "source": "/driver.js",
      "destination": "/driver/driver.js"
    }
  ]
}